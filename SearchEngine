    <script>
        function googleSearch(type) {
            var targetDomain = document.getElementById('target').value;

            if (!targetDomain) {
                alert('Please enter a target domain.');
                return;
            }

            var searchQuery = 'site:' + targetDomain;

            switch (type) {
                case 1: searchQuery += ' intitle:index.of'; break;
                case 2: searchQuery += ' ext:xml | ext:conf | ext:cnf | ext:reg | ext:inf | ext:rdp | ext:cfg | ext:txt | ext:ora | ext:ini'; break;
                case 3: searchQuery += ' ext:sql | ext:dbf | ext:mdb'; break;
                case 4: searchQuery += ' ext:log'; break;
                case 5: searchQuery += ' ext:bkf | ext:bkp | ext:bak | ext:old | ext:backup'; break;
                case 6: searchQuery += ' inurl:login'; break;
                case 7: searchQuery += ' intext:"sql syntax near" | intext:"syntax error has occurred" | intext:"incorrect syntax near" | intext:"unexpected end of SQL command"'; break;
                case 8: searchQuery += ' ext:doc | ext:docx | ext:odt | ext:pdf | ext:rtf | ext:sxw | ext:psw | ext:ppt | ext:pptx | ext:pps | ext:csv'; break;
                case 9: searchQuery += ' ext:php intitle:phpinfo "published by the PHP Group"'; break;
                case 10: searchQuery += ' inurl:wp- | inurl:wp-content | inurl:plugins | inurl:uploads | inurl:themes | inurl:download'; break;
                case 11: searchQuery += ' inurl:shell | inurl:backdoor | inurl:wso | inurl:cmd | shadow | passwd | boot.ini | inurl:backdoor'; break;
                case 12: searchQuery += ' inurl:readme | inurl:license | inurl:install | inurl:setup | inurl:config'; break;
                case 13: searchQuery += ' inurl:redir | inurl:url | inurl:redirect | inurl:return | inurl:src=http | inurl:r=http'; break;
                case 14: searchQuery += ' ext:action | ext:struts | ext:do'; break;
                case 15: searchQuery += ' site:pastebin.com ' + targetDomain; break;
                case 16: searchQuery += ' site:linkedin.com employees ' + targetDomain; break;
                case 17: searchQuery += ' inurl:"/phpinfo.php" | inurl:".htaccess" | inurl:"/.git" ' + targetDomain + ' -github'; break;
                case 18: searchQuery += ' site:*.' + targetDomain; break;
                case 19: searchQuery += ' site:*.*.' + targetDomain; break;
                case 20: searchQuery += ' inurl:wp-content | inurl:wp-includes ' + targetDomain; break;
                case 21: searchQuery += ' site:' + targetDomain + ' mime:swf'; break;
                case 22: searchQuery += ' inurl:/admin.aspx'; break;
                case 23: searchQuery += ' intitle:"index of "main.yml"'; break;
