                case 28: searchQuery += ' intitle:index.of conf.php'; break;
                case 29: searchQuery += ' intitle:"Sharing API Info"'; break;
                case 30: searchQuery += ' inurl:user intitle:"Drupal" intext:"Log in" -"powered by"'; break;
                case 31: searchQuery += ' inurl: /libraries/joomla/database/'; break;
                case 32: searchQuery += ' inurl:"php?sql=select" ext:php'; break;
                case 33: searchQuery += ' inurl:"wp-content" intitle:"index.of" intext:wp-config.php'; break;
                case 34: searchQuery += ' intitle:index.of conf.mysql'; break;
                case 35: searchQuery += ' intitle:"index of" "users.yml" | "admin.yml" | "config.yml"'; break;
                case 36: searchQuery += ' intitle:"index of" "docker-compose.yml"'; break;
