                case 42: searchQuery += ' "docker-compose.yml"'; break;
                default:
                    alert('Invalid option.');
                    return;
            }

            var url = 'https://www.google.com/search?q=' + encodeURIComponent(searchQuery);
            window.open(url, '_blank');
        }

